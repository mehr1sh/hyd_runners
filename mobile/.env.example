# Copy to .env.local for `expo start` against a local stack. For EAS builds,
# set these per environment (development / preview / production) with
# `eas env:create` instead. Only public values: never the Supabase secret key.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3000
