# Copy to .env.local for local development. Never commit real values.
# Vercel: set the same names under Project → Settings → Environment Variables,
# with Production pointing at the production Supabase project and Preview at
# the staging project.

# --- Public (compiled into the browser bundle; safe only because RLS protects data) ---
# Local: API URL and Publishable key printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leaflet raster tiles. Default: OpenStreetMap standard tiles (light use only,
# attribution required). Switch provider here without code changes.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase secret key (sb_secret_...). Bypasses RLS. Server code only.
SUPABASE_SECRET_KEY=

# AI for timetable images and scanned PDFs: gemini | none.
# "none" uses the deterministic fallback everywhere. "anthropic" is accepted
# but has no adapter yet, so it also falls back.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_CALL_LIMIT=10
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Enables POST /api/v1/dev/seed-demo in production (Bearer token). Leave empty
# to keep the endpoint disabled outside development.
DEMO_SEED_TOKEN=
