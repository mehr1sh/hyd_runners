# Copy to .env.local for local development. Never commit real values.
# Vercel: set the same names under Project → Settings → Environment Variables.

# --- Public (shipped to the browser; safe only because RLS protects data) ---
# Local: printed by `pnpm db:start` (API URL and Publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leaflet raster tiles. Default: OpenStreetMap standard tiles (light use only,
# attribution required). Switch provider here without code changes.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase secret key (sb_secret_...). Bypasses RLS. Server code only.
SUPABASE_SECRET_KEY=

# AI: "none" forces the deterministic fallback everywhere.
# anthropic | gemini | none
AI_PROVIDER=none
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_CALL_LIMIT=10
