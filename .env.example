# Copy to .env.local for local development. Never commit real values.
# Vercel: Production and Preview share one Supabase project. Give Preview only
# the NEXT_PUBLIC_* values (NEXT_PUBLIC_SITE_URL = the production URL in both)
# and optional AI settings; keep SUPABASE_SECRET_KEY and DEMO_SEED_TOKEN
# Production-only.

# --- Public (compiled into the browser bundle; safe only because RLS protects data) ---
# Local: API URL and Publishable key printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leaflet raster tiles. Default: OpenStreetMap standard tiles (light use only,
# attribution required). Switch provider here without code changes.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase secret key (sb_secret_...). Bypasses RLS. Server code only; never in a
# NEXT_PUBLIC_ variable (the build refuses one) and never in Vercel Preview.
SUPABASE_SECRET_KEY=

# AI for timetable images and scanned PDFs: gemini | none.
# "none" uses the deterministic fallback everywhere. "anthropic" is accepted
# but has no adapter yet, so it also falls back.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_CALL_LIMIT=10
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Enables POST /api/v1/dev/seed-demo in production (Bearer token). Leave empty
# to keep the endpoint disabled outside development.
DEMO_SEED_TOKEN=

# Read-only E2E against a deployment (PLAYWRIGHT_BASE_URL): a dedicated
# runner-only test account in the shared project. Not used by the app.
E2E_RUNNER_EMAIL=
E2E_RUNNER_PASSWORD=
